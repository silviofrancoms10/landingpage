---
import '../styles/components/Contact.css';
---
<section id="contato" class="contact-section">
    <div class="container contact-container">
        <div class="liquid-glass contact-card">
            <div class="contact-bg-effect"></div>

            <div class="contact-grid">
                <!-- Info -->
                <div class="contact-info">
                    <h2 class="contact-title">
                        Pronto para o próximo <span class="text-vue-green">salto de escala</span>?
                    </h2>
                    <p class="contact-text">
                        Agende uma consultoria gratuita hoje e descubra exatamente onde você está perdendo dinheiro.
                    </p>
                    <div class="contact-items">
                        <div class="contact-item">
                            <div class="contact-icon-wrapper">
                                <svg class="contact-icon" fill="currentColor" viewBox="0 0 20 20"><path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"></path></svg>
                            </div>
                            <span class="contact-item-text">+55 (67) 98117-8782</span>
                        </div>
                        <div class="contact-item">
                            <div class="contact-icon-wrapper">
                                <svg class="contact-icon" fill="currentColor" viewBox="0 0 20 20"><path d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z"></path><path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z"></path></svg>
                            </div>
                            <span class="contact-item-text text-break">contato@dsdesenvolvimento.com</span>
                        </div>
                    </div>
                </div>

                <!-- Form -->
                <form class="contact-form">
                    <input type="text" placeholder="Seu Nome" class="contact-input" required />
                    <input type="email" placeholder="Seu E-mail" class="contact-input" required />
                    <input type="tel" placeholder="Seu WhatsApp" class="contact-input" required />
                    <textarea placeholder="Fale um pouco sobre seu negócio" rows="4" class="contact-textarea"></textarea>
                    <button type="submit" class="contact-submit">
                        Enviar e Escalar 🚀
                    </button>
                </form>
            </div>
        </div>
    </div>
</section>
