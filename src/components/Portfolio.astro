---
import '../styles/components/Portfolio.css';
---
<section id="portfolio" class="portfolio-section">
    <div class="container portfolio-container">
        <div class="portfolio-header">
            <h2 class="portfolio-title">
                Resultados que falam por si
            </h2>
            <p class="portfolio-subtitle">
                Cases reais de empresas que saíram da invisibilidade para a liderança digital.
            </p>
        </div>

        <div class="portfolio-grid">
            <div class="glass-card portfolio-card group">
                <div class="portfolio-img-wrapper img-ecommerce">
                    <div class="portfolio-img-overlay overlay-ecommerce"></div>
                </div>
                <div class="portfolio-card-content">
                    <span class="portfolio-badge">E-commerce de Luxo</span>
                    <h4 class="portfolio-card-title">+340% em vendas em 6 meses</h4>
                    <p class="portfolio-card-text">
                        Reestruturação completa de Landing Pages e estratégia agressiva de Google Shopping.
                    </p>
                </div>
            </div>

            <div class="glass-card portfolio-card group">
                <div class="portfolio-img-wrapper img-clinic">
                    <div class="portfolio-img-overlay overlay-clinic"></div>
                </div>
                <div class="portfolio-card-content">
                    <span class="portfolio-badge">Clínica Odontológica</span>
                    <h4 class="portfolio-card-title">Domínio total do mercado local</h4>
                    <p class="portfolio-card-text">
                        SEO Local + Anúncios Geo-localizados resultando em agenda lotada 24/7.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>
