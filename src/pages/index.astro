---
import Layout from "../layouts/Layout.astro";
import Testimonials from "../components/Testimonials.vue";

import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Services from "../components/Services.astro";
import Portfolio from "../components/Portfolio.astro";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";
import WhatsAppButton from "../components/WhatsAppButton.astro";

import "../styles/components/Index.css";
---

<Layout
	title="DS Desenvolvimento | Transforme Visitantes em Clientes com Estratégias de Elite"
>
	<Header />

	<main>
		<Hero />
		<Services />
		<!-- <Portfolio /> -->

		<!-- Depoimentos (Prova Social) -->
		<section class="testimonials-wrapper">
			<div class="container">
				<div class="testimonials-header">
					<h2 class="testimonials-title">
						O que dizem nossos <span class="text-vue-green"
							>parceiros</span
						>
					</h2>
					<p class="testimonials-subtitle">
						A confiança de quem já escalou seus resultados conosco.
					</p>
				</div>
				<Testimonials client:visible />
			</div>
		</section>

		<Contact />
	</main>

	<Footer />
	<WhatsAppButton />
</Layout>
